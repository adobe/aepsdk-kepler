{
  "name": "vega-sample-app",
  "version": "1.0.0",
  "description": "Sample app demonstrating the usage of AEP Vega SDK",
  "main": "index.js",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint .",
    "clean": "rm -rf node_modules",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:app": "build:release build:debug"
  },
  "dependencies": {
    "@adobe/vega-aepcore": "file:../../packages/core",
    "@adobe/vega-aepmedia": "file:../../packages/media",
    "@amazon-devices/react-native-kepler": "4.0.0",
    "@react-native-community/cli-tools": "20.0.0",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "0.22.14",
    "@amazon-devices/kepler-module-manifest-builder": "0.1.16",
    "@amazon-devices/keplerscript-commonmodules": "1.1.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mustache": "^4.2.0",
    "npm-run-all": "^4.1.5",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.1.2",
    "typescript": "5.8.3"
  },
  "kepler": {
    "projectType": "application",
    "appName": "vegasampleapp",
    "targets": [
      "tv"
    ],
    "api": 0.1
  }
}
