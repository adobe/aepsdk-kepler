{
  "name": "aepsdk-vega",
  "version": "1.0.1",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/TestApp",
    "integrationTests"
  ],
  "scripts": {
    "fix_format": "npx prettier ./packages/**/**.ts --write --config ./.prettierrc.json",
    "format": "npx prettier ./packages/**/**.ts --check --config ./.prettierrc.json",
    "lint": "npx eslint ./packages/**/src/**/**.ts",
    "build_all": "npx lerna run build",
    "unit_test": "npx lerna run test",
    "unit_test_report": "npx lerna run testReport",
    "integration_test": "cd integrationTests && npx jest",
    "archive_all": "rm -rf ./out; mkdir out; npx lerna run archive",
    "build_sample_app": "./scripts/buildSampleApp.sh",
    "package_sdk": "./scripts/packageSDK.sh"
  },
  "devDependencies": {
    "@amazon-devices/react-native-kepler": "4.0.0",
    "@babel/core": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@babel/traverse": "7.22.8",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "lerna": "^8.0.0",
    "mustache": "^4.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.6.2",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.1.2",
    "typescript": "5.8.3"
  },
  "overrides": {
    "react": "19.2.0",
    "react-native": "0.83.0"
  }
}
